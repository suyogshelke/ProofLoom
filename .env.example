# ProofLoom environment variables
# Copy this file to .env and fill in real values before running locally.

# PostgreSQL connection (run via Docker: docker run --name proofloom-db -e POSTGRES_USER=proofloom -e POSTGRES_PASSWORD=proofloom -e POSTGRES_DB=proofloom -p 5432:5432 -d postgres:16-alpine)
DATABASE_URL="postgresql://proofloom:proofloom@localhost:5432/proofloom?schema=public"

# JWT secret for session cookies (change in production)
JWT_SECRET="dev-secret-change-me-in-production"

NODE_ENV="development"

# Gemini API key for the judged (LLM) cascade stage
GEMINI_API_KEY="your-gemini-api-key-here"

# NVIDIA NIM / OpenAI-compatible key for the judged (LLM) cascade stage (e.g. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
OPENAI_API_KEY="your-nvidia-nim-api-key-here"
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
